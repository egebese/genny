{
  "endpointId": "fal-ai/kling-video/v2.5-turbo/pro/image-to-video",
  "modality": "video",
  "group": "Image to Video",
  "displayName": "Kling 2.5 Turbo Pro (from an image)",
  "description": "Kling 2.5 Turbo Pro: Top-tier image-to-video generation with unparalleled motion fluidity, cinematic visuals, and exceptional prompt precision.",
  "sortOrder": 2,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.07,
    "note": "fal quotes a 5s bundle at $0.35 plus $0.07 per extra second. Per second is exact for both durations the model offers: 5s costs $0.35, 10s costs $0.70."
  },
  "creditMultiplier": 1.2,
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "label": "Prompt",
      "required": true
    },
    {
      "name": "duration",
      "type": "enum",
      "label": "Length",
      "default": "5",
      "enum": ["5", "10"]
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "label": "Avoid",
      "default": "blur, distort, and low quality"
    },
    {
      "name": "cfg_scale",
      "type": "number",
      "label": "Guidance",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "references": [
    {
      "field": "image_url",
      "role": "start-frame",
      "accepts": ["image"],
      "required": true,
      "array": false,
      "maxCount": 1,
      "token": "strip"
    },
    {
      "field": "tail_image_url",
      "role": "end-frame",
      "accepts": ["image"],
      "required": false,
      "array": false,
      "maxCount": 1,
      "token": "strip"
    }
  ],
  "capabilities": {
    "supportsNegativePrompt": true,
    "maxOutputs": 1
  },
  "thumbnailUrl": "/models/kling-video-v2-5-turbo-pro-image-to-video.svg",
  "markUrl": "/models/marks/kling.svg"
}
