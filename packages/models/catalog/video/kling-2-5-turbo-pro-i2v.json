{
  "endpointId": "fal-ai/kling-video/v2.5-turbo/pro/image-to-video",
  "modality": "video",
  "group": "Image to Video",
  "displayName": "Kling 2.5 Turbo Pro (from an image)",
  "description": "Animates a still. Mention an image with @ and Kling moves it for five or ten seconds.",
  "sortOrder": 2,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.07
  },
  "creditMultiplier": 1.2,
  "inputs": [
    { "name": "prompt", "type": "string", "label": "Prompt", "required": true },
    {
      "name": "duration",
      "type": "enum",
      "label": "Length",
      "default": "5",
      "enum": ["5", "10"]
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "label": "Avoid",
      "default": "blur, distort, and low quality"
    },
    {
      "name": "cfg_scale",
      "type": "number",
      "label": "Guidance",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "references": [
    {
      "field": "image_url",
      "required": true,
      "array": false,
      "maxCount": 1,
      "token": "strip"
    }
  ],
  "capabilities": {
    "supportsNegativePrompt": true,
    "maxOutputs": 1
  }
}
