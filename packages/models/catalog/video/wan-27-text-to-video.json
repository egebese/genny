{
  "endpointId": "fal-ai/wan/v2.7/text-to-video",
  "family": {
    "id": "wan-27",
    "name": "Wan 2.7"
  },
  "modality": "video",
  "group": "Text to Video",
  "displayName": "Wan 2.7 Text to Video",
  "description": "Wan 2.7 generating video from a prompt alone, with optional audio.",
  "sortOrder": 61,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.1,
    "note": "720p, which is the tier this entry pins; 1080p is $0.15 per second. fal's prose and `genmedia pricing` agree on $0.10."
  },
  "creditMultiplier": 1.25,
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "label": "Prompt",
      "required": true
    },
    {
      "name": "duration",
      "type": "integer",
      "label": "Length",
      "default": 5,
      "min": 2,
      "max": 15
    },
    {
      "name": "aspect_ratio",
      "type": "enum",
      "label": "Aspect",
      "default": "16:9",
      "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"]
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "label": "Avoid"
    },
    {
      "name": "seed",
      "type": "integer",
      "label": "Seed"
    },
    {
      "name": "resolution",
      "type": "enum",
      "label": "Resolution",
      "default": "720p",
      "enum": ["720p"],
      "hidden": true
    }
  ],
  "references": [
    {
      "field": "audio_url",
      "role": "driving-audio",
      "accepts": ["audio"],
      "required": false,
      "array": false,
      "maxCount": 1,
      "token": "strip"
    }
  ],
  "capabilities": {
    "supportsNegativePrompt": true,
    "maxOutputs": 1
  },
  "markUrl": "/models/marks/alibaba.svg",
  "artUrl": "/models/art/wan-v2-7-text-to-video.webp"
