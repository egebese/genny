{
  "endpointId": "fal-ai/wan/v2.7/reference-to-video",
  "modality": "video",
  "group": "Reference to Video",
  "displayName": "Wan 2.7 Reference to Video",
  "description": "Wan 2.7 is the latest generation AI video model, delivering enhanced motion smoothness, superior scene fidelity, and greater visual coherence.",
  "sortOrder": 5,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.1,
    "note": "Flat per second of output, at every resolution. fal's prose and `genmedia pricing` agree. fal bills input video duration on top when a reference video is sent, which is why this entry declares no video reference slot."
  },
  "creditMultiplier": 1.2,
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "label": "Prompt",
      "required": true
    },
    {
      "name": "duration",
      "type": "integer",
      "label": "Length (seconds)",
      "default": 5,
      "min": 2,
      "max": 10
    },
    {
      "name": "aspect_ratio",
      "type": "enum",
      "label": "Aspect",
      "default": "16:9",
      "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"]
    },
    {
      "name": "resolution",
      "type": "enum",
      "label": "Resolution",
      "default": "1080p",
      "enum": ["720p", "1080p"]
    },
    {
      "name": "multi_shots",
      "type": "boolean",
      "label": "Multiple shots",
      "default": false
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "label": "Avoid"
    },
    {
      "name": "seed",
      "type": "integer",
      "label": "Seed"
    }
  ],
  "references": [
    {
      "field": "reference_image_urls",
      "role": "reference",
      "accepts": ["image"],
      "required": false,
      "array": true,
      "maxCount": 4,
      "token": "keep-label"
    }
  ],
  "capabilities": {
    "supportsNegativePrompt": true,
    "supportsSeed": true,
    "maxOutputs": 1
  },
  "markUrl": "/models/marks/alibaba.svg",
  "artUrl": "/models/art/wan-v2-7-reference-to-video.webp"
}
