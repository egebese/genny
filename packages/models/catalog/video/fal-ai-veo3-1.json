{
  "endpointId": "fal-ai/veo3.1",
  "family": {
    "id": "veo-31",
    "name": "Google Veo 3.1"
  },
  "modality": "video",
  "group": "Text to Video",
  "displayName": "Google Veo 3.1 Text to Video",
  "description": "The full model. What Veo looks like when nothing is traded away. Here, writing a clip from a sentence.",
  "sortOrder": 2600,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.4,
    "waiveDriftCheck": true,
    "note": "fal publishes $0.2 per second of output without audio and $0.4 with it, at 720p and 1080p; at 4K it is $0.4 without and $0.6 with. Priced from 1080p with audio, which is the default, and scaled from there. The four rates are not a product of two factors, so they are keyed on both controls together.",
    "scale": [
      {
        "field": "resolution",
        "and": "generate_audio",
        "factors": {
          "720p|false": 0.5,
          "1080p|false": 0.5,
          "4k|true": 1.5,
          "4k|false": 1
        }
      }
    ]
  },
  "creditMultiplier": 1.25,
  "promptField": "prompt",
  "inputs": [
    {
      "name": "prompt",
      "label": "Prompt",
      "required": true,
      "type": "string"
    },
    {
      "name": "aspect_ratio",
      "label": "Aspect ratio",
      "default": "16:9",
      "type": "enum",
      "enum": ["16:9", "9:16"]
    },
    {
      "name": "resolution",
      "label": "Resolution",
      "default": "720p",
      "type": "enum",
      "enum": ["720p", "1080p", "4k"]
    },
    {
      "name": "negative_prompt",
      "label": "Negative prompt",
      "type": "string"
    },
    {
      "name": "duration",
      "label": "Duration",
      "default": "8s",
      "type": "enum",
      "enum": ["4s", "6s", "8s"]
    },
    {
      "name": "auto_fix",
      "label": "Auto fix",
      "default": true,
      "type": "boolean"
    },
    {
      "name": "generate_audio",
      "label": "Generate audio",
      "default": true,
      "type": "boolean"
    },
    {
      "name": "seed",
      "label": "Seed",
      "type": "integer"
    },
    {
      "name": "safety_tolerance",
      "label": "Safety tolerance",
      "default": "4",
      "type": "enum",
      "enum": ["1", "2", "3", "4", "5", "6"]
    }
  ],
  "references": [],
  "capabilities": {
    "supportsNegativePrompt": true,
    "supportsSeed": true,
    "maxOutputs": 1
  },
  "markUrl": "/models/marks/gemini.svg"
}
