{
  "endpointId": "fal-ai/wan/v2.7/edit-video",
  "modality": "video",
  "group": "Editing",
  "displayName": "Wan 2.7 Video Edit",
  "description": "Wan 2.7 is the latest generation AI video model, delivering enhanced motion smoothness, superior scene fidelity, and greater visual coherence.",
  "sortOrder": 6,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.1,
    "note": "720p, which is the tier this entry pins; 1080p is $0.15 per second. Billed on output seconds, so the length control below is what the request costs. fal's prose and `genmedia pricing` agree on $0.10."
  },
  "creditMultiplier": 1.2,
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "label": "Instruction",
      "required": true
    },
    {
      "name": "duration",
      "type": "integer",
      "label": "Length (seconds)",
      "default": 5,
      "min": 2,
      "max": 10
    },
    {
      "name": "audio_setting",
      "type": "enum",
      "label": "Audio",
      "default": "auto",
      "enum": ["auto", "origin"]
    },
    {
      "name": "resolution",
      "type": "enum",
      "label": "Resolution",
      "default": "720p",
      "enum": ["720p"],
      "hidden": true
    },
    {
      "name": "seed",
      "type": "integer",
      "label": "Seed"
    }
  ],
  "references": [
    {
      "field": "video_url",
      "role": "source",
      "accepts": ["video"],
      "required": true,
      "array": false,
      "maxCount": 1,
      "token": "strip"
    },
    {
      "field": "reference_image_url",
      "role": "reference",
      "accepts": ["image"],
      "required": false,
      "array": false,
      "maxCount": 1,
      "token": "strip"
    }
  ],
  "capabilities": {
    "supportsSeed": true,
    "maxOutputs": 1
  },
  "thumbnailUrl": "/models/wan-v2-7-edit-video.svg",
  "markUrl": "/models/marks/alibaba.svg"
}
