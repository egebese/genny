{
  "endpointId": "minimax/h3/reference-to-video",
  "family": {
    "id": "h3",
    "name": "MiniMax H3"
  },
  "modality": "video",
  "group": "Image to Video",
  "displayName": "MiniMax H3 Reference to Video",
  "description": "H3 at the standard tier, up to fifteen seconds a shot. Here, holding reference images consistent.",
  "sortOrder": 3320,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.13,
    "waiveDriftCheck": true,
    "note": "fal publishes $0.05 per second of output at 480P, $0.06 at 768P, $0.13 at 2K and $0.16 at 4K. Priced from the 2K default. genmedia reports $0.00017 per compute second, which is not what a request is charged.",
    "scale": [
      {
        "field": "resolution",
        "factors": {
          "480P": 0.3846,
          "768P": 0.4615,
          "4K": 1.2308
        }
      }
    ]
  },
  "creditMultiplier": 1.25,
  "promptField": "prompt",
  "inputs": [
    {
      "name": "prompt_expansion_mode",
      "label": "Prompt expansion mode",
      "default": "balanced",
      "type": "enum",
      "enum": ["disabled", "fast", "balanced", "quality"]
    },
    {
      "name": "duration",
      "label": "Duration",
      "default": 5,
      "type": "integer",
      "min": 5,
      "max": 15
    },
    {
      "name": "prompt",
      "label": "Prompt",
      "required": true,
      "type": "string"
    },
    {
      "name": "resolution",
      "label": "Resolution",
      "default": "2K",
      "type": "enum",
      "enum": ["480P", "768P", "2K", "4K"]
    },
    {
      "name": "sync_mode",
      "label": "Sync mode",
      "default": false,
      "type": "boolean"
    },
    {
      "name": "seed",
      "label": "Seed",
      "type": "integer"
    },
    {
      "name": "enable_safety_checker",
      "label": "Enable safety checker",
      "default": true,
      "type": "boolean"
    },
    {
      "name": "aspect_ratio",
      "label": "Aspect ratio",
      "default": "adaptive",
      "type": "enum",
      "enum": ["adaptive", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]
    }
  ],
  "references": [
    {
      "field": "reference_audio_urls",
      "role": "driving-audio",
      "accepts": ["audio"],
      "required": false,
      "array": true,
      "maxCount": 3,
      "token": "strip",
      "label": "Use as driving audio"
    },
    {
      "field": "reference_video_urls",
      "role": "reference",
      "accepts": ["video"],
      "required": false,
      "array": true,
      "maxCount": 3,
      "token": "strip",
      "label": "Use as reference clip"
    },
    {
      "field": "reference_image_urls",
      "role": "reference",
      "accepts": ["image"],
      "required": false,
      "array": true,
      "maxCount": 9,
      "token": "strip",
      "label": "Use as reference"
    }
  ],
  "capabilities": {
    "supportsNegativePrompt": false,
    "supportsSeed": true,
    "maxOutputs": 1
  },
  "markUrl": "/models/marks/minimax.svg"
}
