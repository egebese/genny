      "label": "Prompt",
      "required": true
    },
    {
      "name": "duration",
      "type": "integer",
      "label": "Length",
      "default": 5,
      "min": 1,
      "max": 10
    },
    {
      "name": "aspect_ratio",
      "type": "enum",
      "label": "Aspect",
      "default": "16:9",
      "enum": ["16:9", "4:3", "1:1", "3:4", "9:16", "2:3", "3:2", "21:9"]
    },
    {
      "name": "seed",
      "type": "integer",
      "label": "Seed"
    },
    {
      "name": "resolution",
      "type": "enum",
      "label": "Resolution",
      "default": "720p",
      "enum": ["720p"],
      "hidden": true
    },
    {
      "name": "generate_audio_switch",
      "type": "boolean",
      "label": "Audio",
      "default": false,
      "hidden": true
    }
  ],
  "references": [],
