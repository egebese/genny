{
  "endpointId": "fal-ai/kling-video/o3/standard/video-to-video/edit",
  "family": {
    "id": "kling-o3",
    "name": "Kling O3"
  },
  "modality": "video",
  "group": "Video Editing",
  "displayName": "Kling O3 Standard Video Edit",
  "description": "Rewrites a clip you already have, following the prompt, at the standard tier.",
  "sortOrder": 2490,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.126,
    "waiveDriftCheck": true,
    "note": "fal publishes a flat $0.126 per second of output. genmedia reports $0.14. It has no length control: the output is as long as the clip it is given, which fal limits to fifteen seconds, so the hold assumes that ceiling and settle returns the rest.",
    "duration": {
      "assume": 15,
      "unit": "seconds"
    }
  },
  "creditMultiplier": 1.25,
  "promptField": "prompt",
  "inputs": [
    {
      "name": "shot_type",
      "label": "Shot type",
      "default": "customize",
      "type": "enum",
      "enum": ["customize"]
    },
    {
      "name": "prompt",
      "label": "Prompt",
      "required": true,
      "type": "string"
    },
    {
      "name": "keep_audio",
      "label": "Keep audio",
      "default": true,
      "type": "boolean"
    },
    {
      "name": "elements",
      "label": "Elements",
      "type": "object-array",
      "fields": [
        {
          "name": "frontal_image_url",
          "label": "Frontal image",
          "type": "string"
        }
      ]
    }
  ],
  "references": [
    {
      "field": "video_url",
      "role": "source",
      "accepts": ["video"],
      "required": true,
      "array": false,
      "maxCount": 1,
      "token": "strip",
      "label": "Edit this clip"
    },
    {
      "field": "image_urls",
      "role": "reference",
      "accepts": ["image"],
      "required": false,
      "array": true,
      "maxCount": 1,
      "token": "strip",
      "label": "Use as reference"
    }
  ],
  "capabilities": {
    "supportsNegativePrompt": false,
    "supportsSeed": false,
    "maxOutputs": 1
  },
  "markUrl": "/models/marks/kling.svg"
}
