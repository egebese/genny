{
  "endpointId": "alibaba/wan-3.0-prime/reference-to-video",
  "family": {
    "id": "wan-3",
    "name": "Wan 3.0"
  },
  "modality": "video",
  "group": "Image to Video",
  "displayName": "Wan 3.0 Prime Reference to Video",
  "description": "The tuned Wan, steadier and about forty percent dearer. Here, holding reference images consistent.",
  "sortOrder": 2950,
  "pricing": {
    "unit": "seconds",
    "unitPriceUsd": 0.28,
    "waiveDriftCheck": true,
    "note": "fal publishes $0.068 per second of output at 480p, $0.14 at 720p and $0.28 at 1080p. Priced from the 1080p default.",
    "scale": [
      {
        "field": "resolution",
        "factors": {
          "480p": 0.2429,
          "720p": 0.5
        }
      }
    ],
    "duration": {
      "assume": 30,
      "unit": "seconds"
    }
  },
  "creditMultiplier": 1.25,
  "promptField": "prompt",
  "inputs": [
    {
      "name": "prompt",
      "label": "Prompt",
      "type": "string",
      "required": true
    },
    {
      "name": "resolution",
      "label": "Resolution",
      "default": "1080p",
      "type": "enum",
      "enum": ["480p", "720p", "1080p"]
    },
    {
      "name": "enable_prompt_expansion",
      "label": "Enable prompt expansion",
      "default": true,
      "type": "boolean"
    },
    {
      "name": "audio",
      "label": "Audio",
      "default": true,
      "type": "boolean"
    },
    {
      "name": "aspect_ratio",
      "label": "Aspect ratio",
      "default": "adaptive",
      "type": "enum",
      "enum": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16"]
    },
    {
      "name": "enable_safety_checker",
      "label": "Enable safety checker",
      "default": true,
      "type": "boolean"
    },
    {
      "name": "enable_thinking",
      "label": "Enable thinking",
      "default": false,
      "type": "boolean"
    },
    {
      "name": "duration",
      "label": "Duration",
      "default": 5,
      "type": "integer",
      "min": 2,
      "max": 30
    },
    {
      "name": "seed",
      "label": "Seed",
      "type": "integer",
      "min": 0,
      "max": 2147483647
    }
  ],
  "references": [
    {
      "field": "web_url",
      "role": "source",
      "accepts": ["image"],
      "required": false,
      "array": false,
      "maxCount": 1,
      "token": "strip"
    },
    {
      "field": "file_url",
      "role": "source",
      "accepts": ["image"],
      "required": false,
      "array": false,
      "maxCount": 1,
      "token": "strip"
    },
    {
      "field": "reference_video_urls",
      "role": "reference",
      "accepts": ["video"],
      "required": false,
      "array": true,
      "maxCount": 5,
      "token": "strip",
      "label": "Use as reference clip"
    },
    {
      "field": "reference_image_urls",
      "role": "reference",
      "accepts": ["image"],
      "required": false,
      "array": true,
      "maxCount": 10,
      "token": "strip",
      "label": "Use as reference"
    },
    {
      "field": "reference_audio_urls",
      "role": "driving-audio",
      "accepts": ["audio"],
      "required": false,
      "array": true,
      "maxCount": 5,
      "token": "strip",
      "label": "Use as driving audio"
    }
  ],
  "capabilities": {
    "supportsNegativePrompt": false,
    "supportsSeed": true,
    "maxOutputs": 1
  },
  "markUrl": "/models/marks/alibaba.svg"
}
