{
  "endpointId": "bytedance/seedream/v5/pro/text-to-image",
  "family": {
    "id": "seedream-5",
    "name": "Seedream 5"
  },
  "modality": "image",
  "group": "Text to Image",
  "displayName": "Seedream 5 Pro",
  "description": "ByteDance's best stills model. Doubles in price above 1536 by 1536, which the default sits under.",
  "sortOrder": 1240,
  "pricing": {
    "unit": "images",
    "unitPriceUsd": 0.0675,
    "waiveDriftCheck": true,
    "note": "fal publishes $0.0675 per image at or below 1536x1536 and $0.135 above it, up to 2048x2048. The size control is a preset rather than a number, so the step is not expressible as a rate here and the entry prices the lower tier; a 2K image is held at half what it costs. Worth revisiting when the sizes become numeric."
  },
  "creditMultiplier": 1.25,
  "promptField": "prompt",
  "inputs": [
    {
      "name": "prompt",
      "label": "Prompt",
      "required": true,
      "type": "string"
    },
    {
      "name": "sync_mode",
      "label": "Sync mode",
      "default": false,
      "type": "boolean"
    },
    {
      "name": "output_format",
      "label": "Output format",
      "default": "jpeg",
      "type": "enum",
      "enum": ["jpeg", "png"]
    },
    {
      "name": "enable_safety_checker",
      "label": "Enable safety checker",
      "default": true,
      "type": "boolean"
    },
    {
      "name": "num_images",
      "label": "Num images",
      "default": 1,
      "type": "integer",
      "min": 1,
      "max": 6
    }
  ],
  "references": [],
  "capabilities": {
    "supportsNegativePrompt": false,
    "supportsSeed": false,
    "maxOutputs": 1
  },
  "markUrl": "/models/marks/bytedance.svg"
