{
  "endpointId": "fal-ai/nano-banana-2",
  "modality": "image",
  "group": "Text to Image",
  "displayName": "Nano Banana 2",
  "description": "Nano Banana 2 is Google's new state-of-the-art fast image generation and editing model",
  "featured": true,
  "sortOrder": 10,
  "pricing": {
    "unit": "images",
    "unitPriceUsd": 0.08,
    "scale": {
      "field": "resolution",
      "factors": {
        "4K": 2
      }
    },
    "note": "fal charges $0.08 per image and charges 4K at double that rate, which is why this entry carries a `scale` factor: the hold has to match or every 4K generation is half price forever."
  },
  "creditMultiplier": 1.25,
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "label": "Prompt",
      "required": true
    },
    {
      "name": "resolution",
      "type": "enum",
      "label": "Resolution",
      "default": "1K",
      "enum": ["0.5K", "1K", "2K", "4K"]
    },
    {
      "name": "aspect_ratio",
      "type": "enum",
      "label": "Aspect ratio",
      "default": "auto",
      "enum": ["auto", "1:1", "16:9", "9:16", "4:3", "3:4"]
    },
    {
      "name": "num_images",
      "type": "integer",
      "label": "Images",
      "default": 1,
      "min": 1,
      "max": 4
    },
    {
      "name": "output_format",
      "type": "enum",
      "label": "Format",
      "default": "png",
      "enum": ["jpeg", "png", "webp"]
    },
    {
      "name": "seed",
      "type": "integer",
      "label": "Seed"
    }
  ],
  "references": [],
  "capabilities": {
    "supportsSeed": true,
    "maxOutputs": 4
  },
  "markUrl": "/models/marks/gemini.svg",
  "artUrl": "/models/art/nano-banana-2.webp"
}
