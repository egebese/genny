{
  "endpointId": "fal-ai/nano-banana-pro/edit",
  "family": {
    "id": "nano-banana-pro",
    "name": "Nano Banana Pro"
  },
  "modality": "image",
  "group": "Editing",
  "displayName": "Nano Banana Pro Edit",
  "description": "Nano Banana Pro is Google's new state-of-the-art image generation and editing model",
  "sortOrder": 1040,
  "pricing": {
    "unit": "images",
    "unitPriceUsd": 0.15,
    "note": "fal's prose and `genmedia pricing` agree on $0.15 per image. 4K is charged double, so this entry offers 1K and 2K only; web search adds $0.015 and is not exposed.",
    "waiveDriftCheck": true
  },
  "creditMultiplier": 1.25,
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "label": "Instruction",
      "required": true
    },
    {
      "name": "resolution",
      "type": "enum",
      "label": "Resolution",
      "default": "1K",
      "enum": ["1K", "2K"]
    },
    {
      "name": "aspect_ratio",
      "type": "enum",
      "label": "Aspect ratio",
      "default": "auto",
      "enum": ["auto", "1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"]
    },
    {
      "name": "num_images",
      "type": "integer",
      "label": "Images",
      "default": 1,
      "min": 1,
      "max": 4
    },
    {
      "name": "output_format",
      "type": "enum",
      "label": "Format",
      "default": "png",
      "enum": ["jpeg", "png", "webp"]
    },
    {
      "name": "seed",
      "type": "integer",
      "label": "Seed"
    }
  ],
  "references": [
    {
      "field": "image_urls",
      "role": "input-images",
      "accepts": ["image"],
      "required": true,
      "array": true,
      "maxCount": 3,
      "token": "keep-label"
    }
  ],
  "capabilities": {
    "supportsSeed": true,
    "maxOutputs": 4
  },
  "markUrl": "/models/marks/gemini.svg",
  "artUrl": "/models/art/nano-banana-pro-edit.webp"
}
