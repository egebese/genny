{
  "endpointId": "fal-ai/ideogram/v3",
  "modality": "image",
  "group": "Text to Image",
  "displayName": "Ideogram Text to Image",
  "description": "Generate high-quality images, posters, and logos with Ideogram V3. Features exceptional typography handling and realistic outputs optimized for commercial and creative use.",
  "sortOrder": 35,
  "pricing": {
    "unit": "images",
    "unitPriceUsd": 0.03
  },
  "creditMultiplier": 1.25,
  "inputs": [
    {
      "name": "prompt",
      "type": "string",
      "label": "Prompt",
      "required": true
    },
    {
      "name": "image_size",
      "type": "enum",
      "label": "Size",
      "default": "square_hd",
      "enum": [
        "square_hd",
        "square",
        "portrait_4_3",
        "portrait_16_9",
        "landscape_4_3",
        "landscape_16_9"
      ]
    },
    {
      "name": "rendering_speed",
      "type": "enum",
      "label": "Speed",
      "default": "BALANCED",
      "enum": ["TURBO", "BALANCED", "QUALITY"]
    },
    {
      "name": "negative_prompt",
      "type": "string",
      "label": "Negative"
    },
    {
      "name": "num_images",
      "type": "integer",
      "label": "Images",
      "default": 1,
      "min": 1,
      "max": 4
    },
    {
      "name": "seed",
      "type": "integer",
      "label": "Seed"
    },
    {
      "name": "expand_prompt",
      "type": "boolean",
      "label": "Expand prompt",
      "default": true,
      "hidden": true
    }
  ],
  "references": [
    {
      "field": "image_urls",
      "array": true,
      "maxCount": 3,
      "token": "keep-label",
      "required": false
    }
  ],
  "capabilities": {
    "supportsNegativePrompt": true,
    "supportsSeed": true,
    "maxOutputs": 4
  },
  "thumbnailUrl": "https://v3b.fal.media/files/b/0a9f91a8/JsTVqtZydplqvV_XGPvTV_5FOy6fcj.png"
}
