# ---------------------------------------------------------------------------
# genny environment. Copy to .env and fill in. packages/env validates all of
# this with zod at boot: a missing or malformed value fails fast, loudly.
# ---------------------------------------------------------------------------

# byok  = users bring their own fal key, no credits, no billing (public demo)
# saas  = server-side fal key, credit ledger, Stripe, admin panel
GENNY_MODE=byok

# --- core ------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-of-base64
# openssl rand -base64 32 -- encrypts the BYOK fal key inside its cookie
GENNY_ENCRYPTION_KEY=replace-me-with-32-bytes-of-base64

# --- database --------------------------------------------------------------
# Local docker (default). For Supabase, swap in its pooled connection string:
# postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://genny_app:genny@localhost:55432/genny
# Elevated role used only by migrations, never by the app
DATABASE_MIGRATION_URL=postgresql://genny_migrator:genny@localhost:55432/genny

# --- storage (S3 API: MinIO locally, S3/R2/Supabase Storage in prod) -------
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=genny
S3_ACCESS_KEY_ID=genny
S3_SECRET_ACCESS_KEY=gennygenny
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9100/genny

# --- fal (saas mode only; in byok mode the user supplies their own) --------
FAL_KEY=

# --- credits (saas mode only) ---------------------------------------------
# 1 USD of fal spend costs this many credits. Your margin lives here.
CREDIT_PER_USD=1000
CREDIT_SIGNUP_GRANT=500

# --- stripe (saas mode only) ----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- auth providers (optional, phase 2) -----------------------------------
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- rate limiting --------------------------------------------------------
# Leave empty to use the Postgres limiter. Redis is an optional accelerator,
# never a requirement.
REDIS_URL=
