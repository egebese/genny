{
  "extends": "@genny/tsconfig/react.json",
  "compilerOptions": {
    "types": ["react", "react-dom", "node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
